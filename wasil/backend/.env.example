# انسخ هذا الملف إلى .env وعدّل القيم (لا ترفع .env إلى Git)

# المنفذ الداخلي (منصات الاستضافة تضبط PORT تلقائياً)
PORT=3000

# الرمز السري الذي يدخله التطبيق في شاشة الإعداد (اجعله طويلاً وعشوائياً)
# مثال لتوليده: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_TOKEN=change-me-to-a-long-random-token

# رقمك الأمريكي بصيغة دولية كما اشتريته من Twilio
US_NUMBER=+14155550134

# اختياري: فعّل التحقق من توقيع Twilio لمنع أي طلب مزيف على webhook
# ضع هنا Auth Token من لوحة Twilio
TWILIO_AUTH_TOKEN=

# اختياري: سر مشترك لحماية webhook العام /sms/generic
WEBHOOK_SECRET=
